[tasks]
invariants
clean

[options]
mode bmc
depth 25

[engines]
smtbmc z3

[script]
read_verilog -sv -formal -I../rtl/common pipeguard_defs.svh pipeline_monitor.sv m2_formal.sv
invariants: chparam -set ASSUME_CLEAN 0 m2_formal
clean:      chparam -set ASSUME_CLEAN 1 m2_formal
prep -top m2_formal

[files]
../rtl/common/pipeguard_defs.svh
../rtl/monitors/pipeline_monitor.sv
m2_formal.sv
